---
import ContactSummary from "../components/ui/ContactSummary.astro";
import CtaLink from "../components/ui/CtaLink.astro";
import PageHero from "../components/ui/PageHero.astro";
import { getMediaAssetById, getNearbyPlaces, getSiteProfile } from "../content";
import { OWLNEST_BOOKING_URL } from "../content/data/booking";
import {
  LEGAL_BUSINESS_INFO,
  LINE_ADD_FRIEND_ALT,
  LINE_ADD_FRIEND_IMAGE,
  LINE_ID,
  LINE_OFFICIAL_URL,
} from "../content/data/business-info";
import MainLayout from "../layouts/MainLayout.astro";

const profile = getSiteProfile();
const places = getNearbyPlaces();
const heroImage = getMediaAssetById("media-brand-hero-sea");
---

<MainLayout title="聯絡我們｜樂圖漫遊會館" description="樂圖漫遊會館聯絡方式，包含電話、LINE ID、Email、地址、Google Maps 與 Facebook。" canonicalPath="/contact" ogImageId="media-brand-hero-sea">
  <main>
    <PageHero eyebrow="Contact" title="聯絡我們" copy="如需確認房型、包棟、接送或租車行程協助，可先整理日期、人數與需求。" image={heroImage} breadcrumbs={[{ label: "聯絡我們" }]} />

    <section class="section">
      <div class="container contact-page-grid">
        <div class="contact-copy">
          <p class="eyebrow">Contact</p>
          <h2 class="section-title">先整理你的住宿需求</h2>
          <p class="section-copy">若要詢問房型、入住日期、接送、租車或包棟需求，建議直接來電，或在 LINE 搜尋 @tour880 聯絡。</p>
          <p class="section-copy">若想先查詢日期與房價，可使用線上查詢；若有接送、包棟或加床需求，仍建議來電確認。</p>
          <div class="line-contact">
            <div>
              <h3>LINE 聯絡</h3>
              <p>LINE ID：{LINE_ID}</p>
              <p>也可在 LINE 搜尋 {LINE_ID} 聯絡我們。</p>
            </div>
            <a class="line-add-friend" href={LINE_OFFICIAL_URL} target="_blank" rel="noopener noreferrer">
              <img src={LINE_ADD_FRIEND_IMAGE} alt={LINE_ADD_FRIEND_ALT} loading="lazy" width="235" height="57" />
            </a>
          </div>
          <ul class="legal-info" aria-label="合法民宿資訊">
            {LEGAL_BUSINESS_INFO.map((item) => <li>{item}</li>)}
          </ul>
          <div class="contact-links" aria-label="社群與地圖連結">
            <CtaLink label="查詢即時房價" href={OWLNEST_BOOKING_URL} target="_blank" rel="noopener noreferrer" tone="accent" size="md" />
            <a href="https://maps.app.goo.gl/oyUcuErtRxpSVAvc7">Google Maps</a>
            <a href="https://www.facebook.com/profile.php?id=100064056636849">Facebook</a>
          </div>
        </div>
        <ContactSummary profile={profile} places={places} />
      </div>
    </section>
  </main>
</MainLayout>

<style>
  .contact-page-grid {
    display: grid;
    gap: var(--space-8);
    align-items: start;
  }

  .contact-copy {
    display: grid;
    gap: var(--space-4);
  }

  .contact-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-4);
  }

  .contact-links a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    padding: 0 var(--space-5);
    color: var(--color-primary);
    background: var(--color-surface);
    font-weight: var(--font-weight-black);
  }

  .line-contact {
    display: grid;
    gap: var(--space-4);
    align-items: center;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-4);
    background: var(--color-surface-muted);
  }

  .line-contact h3,
  .line-contact p {
    margin: 0;
  }

  .line-contact h3 {
    font-size: var(--font-size-lg);
    line-height: var(--line-height-tight);
  }

  .line-contact p {
    color: var(--color-text-muted);
  }

  .line-add-friend {
    display: inline-flex;
    width: min(200px, 100%);
  }

  .line-add-friend img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--radius-sm);
  }

  .legal-info {
    display: grid;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    color: var(--color-text-muted);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-bold);
    list-style: none;
  }

  @media (min-width: 760px) {
    .contact-links {
      max-width: 520px;
    }

    .line-contact {
      grid-template-columns: minmax(0, 1fr) auto;
      max-width: 620px;
    }
  }

  @media (min-width: 900px) {
    .contact-page-grid {
      grid-template-columns: minmax(0, 1fr) minmax(340px, 0.42fr);
    }
  }
</style>
