---
import BrandFeaturesSection from "../components/home/BrandFeaturesSection.astro";
import ContactSummarySection from "../components/home/ContactSummarySection.astro";
import FAQSummarySection from "../components/home/FAQSummarySection.astro";
import HeroSection from "../components/home/HeroSection.astro";
import NationalTravelSubsidyInfo from "../components/NationalTravelSubsidyInfo.astro";
import PrivateStaySection from "../components/home/PrivateStaySection.astro";
import RoomRecommendationsSection from "../components/home/RoomRecommendationsSection.astro";
import {
  getContentSnapshotFromSource,
  getMediaAssetById,
  getNearbyPlaces,
  getPolicies,
  getVillaRentalContent,
} from "../content";
import MainLayout from "../layouts/MainLayout.astro";

const content = await getContentSnapshotFromSource();
const profile = content.siteProfile;
const rooms = content.rooms;
const policies = getPolicies();
const faqs = content.faqs;
const nearbyPlaces = getNearbyPlaces();
const heroMedia = getMediaAssetById("media-brand-hero-sea");
const villaRental = getVillaRentalContent();
const privateStayImage = getMediaAssetById("media-room-private-stay");
const homeSeoDescription = "我們打造的不是房間，而是旅途中真正想回去休息的地方";
---

<MainLayout title={`${profile.name}｜澎湖民宿`} description={homeSeoDescription} canonicalPath="/" ogImageId="media-brand-hero-sea">
  <main>
    <HeroSection profile={profile} media={heroMedia} />
    <NationalTravelSubsidyInfo variant="lovetour" />
    <BrandFeaturesSection profile={profile} policies={policies} />
    <RoomRecommendationsSection rooms={rooms} />
    {villaRental && <PrivateStaySection content={villaRental} image={privateStayImage} />}
    <FAQSummarySection faqs={faqs} />
    <ContactSummarySection profile={profile} places={nearbyPlaces} />
  </main>
</MainLayout>
