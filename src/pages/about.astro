---
import CTASection from "../components/ui/CTASection.astro";
import EmptyState from "../components/ui/EmptyState.astro";
import PageHero from "../components/ui/PageHero.astro";
import { getAboutPageContent, getMediaAssetById } from "../content";
import MainLayout from "../layouts/MainLayout.astro";

const page = getAboutPageContent();
const heroImage = page?.seo.ogImageId ? getMediaAssetById(page.seo.ogImageId) : undefined;
const seo = page?.seo ?? {
  title: "關於樂圖｜樂圖漫遊會館",
  description: "樂圖漫遊會館關於頁內容尚未發布。",
  canonicalPath: "/about",
};
---

<MainLayout title={seo.title} description={seo.description} canonicalPath={seo.canonicalPath} ogImageId={page?.seo.ogImageId}>
  <main>
    {page ? (
      <>
        <PageHero eyebrow="About" title={page.hero.title} copy={page.hero.copy} image={heroImage} breadcrumbs={[{ label: "關於樂圖" }]} />

        <section class="section">
          <div class="container story-grid">
            {page.story.map((item) => (
              <article>
                <h2>{item.title}</h2>
                <p>{item.copy}</p>
              </article>
            ))}
          </div>
        </section>

        <section class="section section-muted">
          <div class="container">
            <p class="eyebrow">Values</p>
            <h2 class="section-title">我們在意的住宿細節</h2>
            <div class="value-grid">
              {page.values.map((value) => (
                <article>
                  <h3>{value.title}</h3>
                  <p>{value.copy}</p>
                </article>
              ))}
            </div>
          </div>
        </section>

        <CTASection title="想先確認適不適合你的旅程？" copy="可以先從房型、包棟或交通資訊看起，也可以直接到聯絡頁整理需求。" primaryLabel="聯絡我們" primaryHref="/contact" secondaryLabel="查看房型" secondaryHref="/rooms" />
      </>
    ) : (
      <section class="section">
        <div class="container">
          <EmptyState title="內容尚未發布" copy="此頁內容目前仍在內部草稿階段。" />
        </div>
      </section>
    )}
  </main>
</MainLayout>

<style>
  .story-grid,
  .value-grid {
    display: grid;
    gap: var(--space-5);
  }

  .story-grid article,
  .value-grid article {
    padding: var(--space-6);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
  }

  h2,
  h3 {
    margin: 0 0 var(--space-3);
    line-height: var(--line-height-heading);
  }

  p {
    margin: 0;
    color: var(--color-text-secondary);
  }

  @media (min-width: 820px) {
    .story-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .value-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
</style>
