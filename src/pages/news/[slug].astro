---
import CTASection from "../../components/ui/CTASection.astro";
import PageHero from "../../components/ui/PageHero.astro";
import { getMediaAssetById, getNewsArticles } from "../../content";
import MainLayout from "../../layouts/MainLayout.astro";

export function getStaticPaths() {
  return getNewsArticles().map((article) => ({
    params: { slug: article.slug },
    props: { article },
  }));
}

const { article } = Astro.props;
const cover = article.coverImageId ? getMediaAssetById(article.coverImageId) : undefined;
---

<MainLayout title={article.seo.title} description={article.seo.description} canonicalPath={article.seo.canonicalPath} ogImageId={article.seo.ogImageId}>
  <main>
    <PageHero eyebrow={article.category} title={article.title} copy={article.summary} image={cover} breadcrumbs={[{ label: "最新消息", href: "/news" }, { label: article.title }]} />

    <article class="section article-body">
      <div class="container article-container">
        <p class="article-date">發布日期：{article.publishedAt}</p>
        {article.body.map((paragraph) => <p>{paragraph}</p>)}
      </div>
    </article>

    <CTASection title="想依照這篇消息詢問住宿？" copy="請到聯絡頁整理住宿需求；目前不串接任何訂房或表單 API。" primaryLabel="聯絡我們" primaryHref="/contact" secondaryLabel="回最新消息" secondaryHref="/news" />
  </main>
</MainLayout>

<style>
  .article-container {
    max-width: 780px;
  }

  .article-date {
    color: var(--color-primary);
    font-weight: var(--font-weight-black);
  }

  .article-body p {
    color: var(--color-text-secondary);
    font-size: var(--font-size-md);
    line-height: var(--line-height-relaxed);
  }
</style>
