---
import CTASection from "../../components/ui/CTASection.astro";
import PageHero from "../../components/ui/PageHero.astro";
import { getContentSnapshotFromSource } from "../../content";
import MainLayout from "../../layouts/MainLayout.astro";

export async function getStaticPaths() {
  const content = await getContentSnapshotFromSource();

  return content.rooms.map((room) => ({
    params: { slug: room.slug },
    props: { room },
  }));
}

const { room } = Astro.props;
const image = room.photos[0];
const extraBedNotice = "所有房型皆可提前詢問加床，實際可加床數量、費用及安排方式，依房型與入住當日狀況確認。";
---

<MainLayout title={`${room.name}｜樂圖漫遊會館`} description={room.summary} canonicalPath={`/rooms/${room.slug}`} ogImageId={image?.id}>
  <main>
    <PageHero eyebrow="Room" title={room.name} copy={room.description ?? room.summary} image={image} breadcrumbs={[{ label: "房型列表", href: "/rooms" }, { label: room.name }]} />

    <section class="section">
      <div class="container room-detail-grid">
        <article class="detail-panel">
          <p class="eyebrow">Room Info</p>
          <h2>房型資訊</h2>
          <dl>
            <div>
              <dt>適合人數</dt>
              <dd>建議 {room.capacity.standard} 人</dd>
            </div>
            <div>
              <dt>床型</dt>
              <dd>{room.bedSetup}</dd>
            </div>
          </dl>
        </article>

        <article class="detail-panel">
          <p class="eyebrow">Amenities</p>
          <h2>房內設備</h2>
          <ul class="chip-list">
            {room.amenities.map((amenity) => <li>{amenity}</li>)}
          </ul>
        </article>

        <article class="detail-panel">
          <p class="eyebrow">Highlights</p>
          <h2>房型特色</h2>
          <ul>
            {room.featureHighlights.map((feature) => <li>{feature}</li>)}
          </ul>
        </article>

        <article class="detail-panel">
          <p class="eyebrow">Notes</p>
          <h2>注意事項</h2>
          <p class="notice-text">{extraBedNotice}</p>
          <ul>
            {room.notes.map((note) => <li>{note}</li>)}
          </ul>
        </article>
      </div>
    </section>

    <CTASection title="想詢問這個房型？" copy="可以先提供入住日期、人數與房型需求，由民宿人員協助確認。" primaryLabel="電話詢問" primaryHref="tel:+886905370600" secondaryLabel="聯絡我們" secondaryHref="/contact" />

    <section class="section">
      <div class="container">
        <a class="back-link" href="/rooms">返回房型列表</a>
      </div>
    </section>
  </main>
</MainLayout>

<style>
  .room-detail-grid {
    display: grid;
    gap: var(--space-5);
  }

  .detail-panel {
    padding: var(--space-6);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
  }

  h2 {
    margin: 0 0 var(--space-4);
  }

  dl,
  ul {
    margin: 0;
  }

  dl {
    display: grid;
    gap: var(--space-4);
  }

  dt {
    color: var(--color-text-secondary);
    font-size: var(--font-size-sm);
  }

  dd {
    margin: var(--space-1) 0 0;
    font-weight: var(--font-weight-black);
  }

  ul {
    display: grid;
    gap: var(--space-3);
    padding-left: var(--space-5);
    color: var(--color-text-secondary);
  }

  .notice-text {
    margin: 0 0 var(--space-4);
    color: var(--color-text-secondary);
  }

  .chip-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    padding-left: 0;
    list-style: none;
  }

  .chip-list li {
    padding: var(--space-2) var(--space-3);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    background: var(--color-surface-muted);
  }

  .back-link {
    color: var(--color-primary);
    font-weight: var(--font-weight-black);
  }

  @media (min-width: 820px) {
    .room-detail-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
