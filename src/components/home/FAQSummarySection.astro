---
import type { FAQContent } from "../../content/types";
import SectionHeading from "../ui/SectionHeading.astro";

interface Props {
  faqs: FAQContent[];
}

const { faqs } = Astro.props;

const faqCategoryLabels: Record<string, string> = {
  "faq-check-in": "Check-in & Check-out",
  "faq-transportation": "Pick-up Service",
  "faq-extra-bed": "Extra Bed",
  "faq-private-stay": "Private Group Stay",
};

const getFaqCategoryLabel = (faq: FAQContent) => faqCategoryLabels[faq.id] ?? faq.category;
---

<section id="faq" class="section">
  <div class="container">
    <SectionHeading
      eyebrow="FAQ"
      title="把常見疑問先整理好，讓詢問更輕鬆"
      copy="為了讓您在訂房前更安心，我們整理了入住時間、接送服務、加床安排與包棟住宿等常見問題。若有特殊需求或想確認細節，歡迎直接與我們聯繫。"
    />
    <div class="faq-list">
      {faqs.slice(0, 4).map((faq) => (
        <article class="faq-card">
          <p>{getFaqCategoryLabel(faq)}</p>
          <h3>{faq.question}</h3>
          <span>{faq.answer}</span>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .faq-list {
    display: grid;
    gap: var(--space-4);
  }

  .faq-card {
    padding: var(--space-6);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
  }

  .faq-card p {
    margin: 0 0 var(--space-2);
    color: var(--color-primary);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-black);
  }

  h3 {
    margin: 0 0 var(--space-3);
    font-size: var(--font-size-lg);
    line-height: var(--line-height-heading);
  }

  span {
    color: var(--color-text-secondary);
  }

  @media (min-width: 768px) {
    .faq-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
