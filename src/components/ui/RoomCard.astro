---
import type { RoomPageContent } from "../../content/types";
import CtaLink from "./CtaLink.astro";

interface Props {
  room: RoomPageContent;
}

const { room } = Astro.props;
const image = room.photos[0];
---

<article class="room-card">
  {image && <img src={image.src} alt={image.alt} />}
  <div class="room-card-body">
    <p class="room-meta">建議 {room.capacity.standard} 人｜{room.bedSetup}</p>
    <h2>{room.name}</h2>
    <p>{room.summary}</p>
    <div class="chips">
      {room.featureHighlights.slice(0, 3).map((feature) => <span>{feature}</span>)}
    </div>
    <div class="actions">
      <CtaLink label="查看房型" href={`/rooms/${room.slug}`} variant="outline" tone="primary" size="sm" />
      <CtaLink label="電話詢問" href="tel:+886905370600" tone="accent" size="sm" />
    </div>
  </div>
</article>

<style>
  .room-card {
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    box-shadow: var(--shadow-sm);
  }

  img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  .room-card-body {
    display: grid;
    gap: var(--space-4);
    padding: var(--space-6);
  }

  .room-meta {
    margin: 0;
    color: var(--color-primary);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-black);
  }

  h2 {
    margin: 0;
    font-size: var(--font-size-xl);
    line-height: var(--line-height-heading);
  }

  p {
    margin: 0;
    color: var(--color-text-secondary);
  }

  .chips,
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .chips span {
    padding: var(--space-2) var(--space-3);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    color: var(--color-text-secondary);
    font-size: var(--font-size-sm);
    background: var(--color-background);
  }
</style>
