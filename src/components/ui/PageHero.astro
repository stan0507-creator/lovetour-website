---
import type { SEOContent } from "../../domain/models";
import Breadcrumbs from "./Breadcrumbs.astro";

interface BreadcrumbItem {
  label: string;
  href?: string;
}

interface Props {
  eyebrow?: string;
  title: string;
  copy?: string;
  image?: { src: string; alt: string };
  breadcrumbs?: BreadcrumbItem[];
  seo?: SEOContent;
}

const { eyebrow, title, copy, image, breadcrumbs = [] } = Astro.props;
---

<section class:list={["page-hero", image && "page-hero--image"]}>
  {image && <img src={image.src} alt={image.alt} />}
  <div class="page-hero-scrim"></div>
  <div class="container page-hero-content">
    {breadcrumbs.length > 0 && <Breadcrumbs items={breadcrumbs} />}
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h1>{title}</h1>
    {copy && <p>{copy}</p>}
  </div>
</section>

<style>
  .page-hero {
    position: relative;
    overflow: hidden;
    padding-block: clamp(var(--space-16), 9vw, var(--space-24));
    background: var(--color-surface-muted);
  }

  .page-hero--image {
    min-height: clamp(420px, 62vh, 620px);
    display: grid;
    align-items: end;
    color: var(--color-surface);
  }

  img,
  .page-hero-scrim {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  img {
    object-fit: cover;
  }

  .page-hero-scrim {
    display: none;
  }

  .page-hero--image .page-hero-scrim {
    display: block;
    background: linear-gradient(180deg, rgba(20, 33, 61, 0.12), rgba(20, 33, 61, 0.78));
  }

  .page-hero-content {
    position: relative;
    display: grid;
    gap: var(--space-4);
  }

  .page-hero--image :global(.breadcrumbs),
  .page-hero--image p {
    color: color-mix(in srgb, var(--color-surface) 82%, transparent);
  }

  .page-hero--image :global(.eyebrow) {
    color: color-mix(in srgb, var(--color-accent) 74%, white);
  }

  h1 {
    max-width: 920px;
    margin: 0;
    font-size: clamp(var(--font-size-3xl), 6vw, var(--font-size-5xl));
    line-height: var(--line-height-tight);
    letter-spacing: var(--letter-spacing-normal);
  }

  p {
    max-width: 760px;
    margin: 0;
    color: var(--color-text-secondary);
    font-size: var(--font-size-md);
    line-height: var(--line-height-relaxed);
  }
</style>
