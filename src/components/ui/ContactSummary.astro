---
import type { NearbyPlaceContent, SiteProfileContent } from "../../content/types";

interface Props {
  profile: SiteProfileContent;
  places?: NearbyPlaceContent[];
}

const { profile, places = [] } = Astro.props;
---

<aside class="contact-summary">
  <div>
    <span>地址</span>
    <strong>{profile.address}</strong>
  </div>
  {profile.contacts.map((contact) => (
    <div>
      <span>{contact.label}</span>
      {contact.href ? <a href={contact.href}>{contact.value}</a> : <strong>{contact.value}</strong>}
    </div>
  ))}
  {profile.contactHours && (
    <div>
      <span>聯絡時間</span>
      <strong>{profile.contactHours}</strong>
    </div>
  )}
  {places.length > 0 && (
    <div class="places">
      <span>交通摘要</span>
      {places.slice(0, 3).map((place) => <p><strong>{place.name}</strong>{place.travelTimeText}</p>)}
    </div>
  )}
</aside>

<style>
  .contact-summary {
    display: grid;
    gap: var(--space-4);
    padding: var(--space-6);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    box-shadow: var(--shadow-md);
  }

  div {
    display: grid;
    gap: var(--space-1);
    padding-bottom: var(--space-4);
    border-bottom: 1px solid var(--color-border);
  }

  div:last-child {
    padding-bottom: 0;
    border-bottom: 0;
  }

  span {
    color: var(--color-text-secondary);
    font-size: var(--font-size-sm);
  }

  strong,
  a {
    font-weight: var(--font-weight-black);
  }

  a:hover {
    color: var(--color-primary);
  }

  .places p {
    display: grid;
    gap: var(--space-1);
    margin: var(--space-2) 0 0;
    color: var(--color-text-secondary);
  }
</style>
