---
import "../styles/national-travel-subsidy.css";

interface Props {
  variant?: "lovetour" | "starrywhale";
  class?: string;
}

const {
  variant = "lovetour",
  class: className = "",
} = Astro.props;
---

<span
  class:list={[
    "national-subsidy-room-tag",
    `national-subsidy-room-tag--${variant}`,
    className,
  ]}
  aria-label="此房型國旅補助適用"
>
  <svg class="national-subsidy-room-tag__icon" viewBox="0 0 16 16" aria-hidden="true">
    <path d="m3.25 8.2 3.1 3.05 6.4-7.1" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"/>
  </svg>
  國旅補助適用
</span>
